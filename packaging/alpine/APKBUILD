# Contributor: Mohit Mishra <mohitmishra786687@gmail.com>
# Maintainer: Mohit Mishra <mohitmishra786687@gmail.com>
pkgname=agentop
pkgver=0.1.2
pkgrel=0
pkgdesc="Terminal dashboard for AI coding assistant sessions"
url="https://github.com/mohitmishra786/agentop"
arch="all"
license="MIT"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/mohitmishra786/$pkgname/archive/refs/tags/v$pkgver.tar.gz"

export GOCACHE="${GOCACHE:-"$srcdir/go-cache"}"
export GOTMPDIR="${GOTMPDIR:-"$srcdir"}"
export GOMODCACHE="${GOMODCACHE:-"$srcdir/go"}"

build() {
	go build -v -trimpath -ldflags "-s -w -X github.com/agentop-dev/agentop/cmd.Version=$pkgver"
}

check() {
	go test ./...
}

package() {
	install -Dm755 $pkgname -t "$pkgdir"/usr/bin/
	install -Dm644 $pkgname.1 \
		"$pkgdir"/usr/share/man/man1/$pkgname.1
	gzip "$pkgdir"/usr/share/man/man1/$pkgname.1
	install -Dm644 LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

sha512sums="
72c1797af9e39a466ac04f7263a724098453fd48dd8cf068238295c345e819954b2f36c53c155e63d23ddf53952b3cd184110da2a2b81b05050df88699866759  agentop-0.1.2.tar.gz
"
