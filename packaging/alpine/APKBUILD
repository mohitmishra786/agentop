# Contributor: Mohit Mishra <mohitmishra786687@gmail.com>
# Maintainer: Mohit Mishra <mohitmishra786687@gmail.com>
pkgname=agentop
pkgver=0.1.1
pkgrel=0
pkgdesc="Terminal dashboard for AI coding assistant sessions — token usage, cost, and cache efficiency"
url="https://github.com/mohitmishra786/agentop"
arch="all"
license="MIT"
makedepends="go"
source="$pkgname-$pkgver.tar.gz::https://github.com/mohitmishra786/$pkgname/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	go build \
		-trimpath \
		-ldflags "-s -w -X main.Version=$pkgver" \
		-o "$pkgname" \
		.
}

check() {
	go test ./...
}

package() {
	install -Dm755 "$builddir/$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 "$builddir/$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
	install -Dm644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

sha512sums="
PLACEHOLDER_RUN_abuild_checksum_TO_FILL_THIS  $pkgname-$pkgver.tar.gz
"
